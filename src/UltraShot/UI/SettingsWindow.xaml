<Window x:Class="UltraShot.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UltraShot Settings"
        Icon="pack://application:,,,/UltraShot;component/ico/UltraShot.ico"
        Width="460" Height="595"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        Foreground="#EEEEEE"
        ResizeMode="NoResize"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Margin" Value="0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Dark ComboBox Item Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#007ACC"/>
                                <Setter Property="TextElement.Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#005A9E"/>
                                <Setter Property="TextElement.Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ComboBox ToggleButton Style -->
        <ControlTemplate x:Key="DarkComboBoxToggleButton" TargetType="ToggleButton">
            <Border x:Name="border" Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" 
                          Data="M 0 0 L 4 4 L 8 0 Z" Fill="#AAAAAA"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="border" Property="BorderBrush" Value="#007ACC"/>
                    <Setter TargetName="border" Property="Background" Value="#2A2A2D"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="border" Property="BorderBrush" Value="#007ACC"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Dark ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="BorderBrush" Value="#3E3E42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Template="{StaticResource DarkComboBoxToggleButton}" 
                                          Focusable="False" 
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                          ClickMode="Press"/>
                            <ContentPresenter IsHitTestVisible="False" 
                                              Content="{TemplateBinding SelectionBoxItem}" 
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
                                              Margin="10,6,30,6" 
                                              VerticalAlignment="Center" 
                                              HorizontalAlignment="Left">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                            <Popup Name="Popup" 
                                   Placement="Bottom" 
                                   IsOpen="{TemplateBinding IsDropDownOpen}" 
                                   AllowsTransparency="True" 
                                   Focusable="False" 
                                   PopupAnimation="Slide">
                                <Grid Name="DropDown" 
                                      SnapsToDevicePixels="True" 
                                      MinWidth="{TemplateBinding ActualWidth}" 
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" 
                                            Background="#1E1E1E" 
                                            BorderThickness="1" 
                                            BorderBrush="#3E3E42" 
                                            CornerRadius="4" 
                                            Margin="0,2,0,0">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="3" Opacity="0.5"/>
                                        </Border.Effect>
                                        <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0098FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#444447"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3E3E42"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="⚙️ UltraShot Preferences" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
            <TextBlock Text="Customize hotkey and general behavior settings." FontSize="12" Foreground="#888888" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Settings Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Hotkey setting -->
                <TextBlock Text="Capture Hotkey" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="HotkeyTextBox" IsReadOnly="True" Background="#252526" Foreground="#00D2FF" 
                             FontWeight="Bold" FontSize="14" Padding="10,8" BorderBrush="#444447"
                             PreviewKeyDown="HotkeyTextBox_PreviewKeyDown" 
                             GotFocus="HotkeyTextBox_GotFocus" 
                             LostFocus="HotkeyTextBox_LostFocus"/>
                    <Button Grid.Column="1" Style="{StaticResource SecondaryBtnStyle}" Content="Reset to Default" 
                            Margin="8,0,0,0" Click="ResetHotkey_Click"/>
                </Grid>

                <TextBlock Text="* Click the box and press keys on your keyboard to change hotkey (e.g. Ctrl+Shift+S or PrintScreen)." 
                           FontSize="11" Foreground="#777777" TextWrapping="Wrap" Margin="0,-10,0,16"/>

                <!-- Save Folder setting -->
                <TextBlock Text="Screenshots Folder" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SaveFolderTextBox" IsReadOnly="True" Background="#252526" Foreground="#DDDDDD" 
                             Padding="10,8" BorderBrush="#444447"/>
                    <Button Grid.Column="1" Style="{StaticResource SecondaryBtnStyle}" Content="Browse..." 
                            Margin="8,0,0,0" Click="BrowseFolder_Click"/>
                </Grid>

                <!-- Format setting -->
                <TextBlock Text="Image Format" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,6"/>
                <ComboBox x:Name="FormatComboBox" Margin="0,0,0,14" SelectionChanged="FormatComboBox_SelectionChanged">
                    <ComboBoxItem Content="PNG (*.png) - Lossless Clarity (Recommended)" Tag="PNG"/>
                    <ComboBoxItem Content="JPEG (*.jpg) - Compressed / Small File Size" Tag="JPEG"/>
                    <ComboBoxItem Content="BMP (*.bmp) - Uncompressed Raw Bitmap" Tag="BMP"/>
                </ComboBox>

                <!-- Advanced Settings Expander -->
                <Expander Header="⚙️ Advanced Settings" Foreground="#00D2FF" FontWeight="SemiBold" Margin="0,0,0,16">
                    <Border Background="#252526" BorderBrush="#333337" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,6,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="JPEG Quality &amp; Compression Level:" Foreground="#DDDDDD" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock x:Name="QualityPercentText" Grid.Column="1" Text="%90" Foreground="#00D2FF" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                            </Grid>
                            
                            <Slider x:Name="QualitySlider" Minimum="10" Maximum="100" Value="90" SmallChange="1" LargeChange="10"
                                    IsSnapToTickEnabled="True" TickFrequency="5" ValueChanged="QualitySlider_ValueChanged" Margin="0,4,0,8"/>
                            
                            <TextBlock x:Name="QualityHintText" Text="* 90% quality drastically reduces file size with virtually no noticeable loss. (Active only for JPEG format)" 
                                       FontSize="11" Foreground="#888888" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Expander>

                <!-- After Capture Action setting -->
                <TextBlock Text="After Capture Action" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,6"/>
                <ComboBox x:Name="AfterCaptureComboBox" Margin="0,0,0,6">
                    <ComboBoxItem Content="Show Recent Screenshots Drawer (Default)" Tag="ShowRecent"/>
                    <ComboBoxItem Content="Show Windows Notification (Click to edit)" Tag="ShowNotification"/>
                    <ComboBoxItem Content="Do Nothing (Quiet mode)" Tag="None"/>
                </ComboBox>
                <TextBlock Text="* Choose what happens after taking a screenshot. Clicking the notification opens the editor directly." 
                           FontSize="11" Foreground="#777777" TextWrapping="Wrap" Margin="0,0,0,16"/>

                <!-- Behaviors -->
                <TextBlock Text="Behaviors" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,6"/>
                <CheckBox x:Name="SaveOnlyToClipboardCheckBox" Content="Save only to clipboard (Temporary mode: Do not save to disk)" 
                          Checked="SaveOnlyToClipboard_Changed" Unchecked="SaveOnlyToClipboard_Changed"/>
                <TextBlock x:Name="TemporaryModeHintText" 
                           Text="* Screenshots taken in temporary mode do not take disk space; they are copied directly to clipboard." 
                           FontSize="11" Foreground="#00D2FF" TextWrapping="Wrap" Margin="20,-2,0,8" Visibility="Collapsed"/>
                <CheckBox x:Name="CopyClipboardCheckBox" Content="Copy to clipboard immediately upon region selection"/>
                <CheckBox x:Name="PlaySoundCheckBox" Content="Play shutter sound after capture"/>
                <CheckBox x:Name="StartWithWindowsCheckBox" Content="Launch automatically on Windows startup"/>
                <CheckBox x:Name="ConfirmDeleteCheckBox" Content="Ask confirmation before deleting in recent screenshots"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Actions -->
        <Border Grid.Row="2" Margin="0,16,0,0" Padding="0,12,0,0" BorderBrush="#333337" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryBtnStyle}" Content="Cancel" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button Style="{StaticResource PrimaryBtnStyle}" Content="Save &amp; Apply" Click="Save_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

