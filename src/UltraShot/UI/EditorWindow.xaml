<Window x:Class="UltraShot.UI.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UltraShot - Screenshot Editor"
        Icon="pack://application:,,,/UltraShot;component/ico/UltraShot.ico"
        Width="1050" Height="700"
        WindowStartupLocation="CenterScreen"
        Background="#181818"
        Foreground="#EEEEEE"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- Modern Toolbar Button Style -->
        <Style x:Key="ToolButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#333337"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3E3E42"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#007ACC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ComboBox Item Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="border" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#007ACC"/>
                                <Setter Property="TextElement.Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#005A9E"/>
                                <Setter Property="TextElement.Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ComboBox ToggleButton Style -->
        <ControlTemplate x:Key="DarkComboBoxToggleButton" TargetType="ToggleButton">
            <Border x:Name="border" Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" 
                          Data="M 0 0 L 3 3 L 6 0 Z" Fill="#AAAAAA"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="border" Property="BorderBrush" Value="#007ACC"/>
                    <Setter TargetName="border" Property="Background" Value="#2A2A2D"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="border" Property="BorderBrush" Value="#007ACC"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Dark ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="BorderBrush" Value="#3E3E42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Template="{StaticResource DarkComboBoxToggleButton}" 
                                          Focusable="False" 
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                          ClickMode="Press"/>
                            <ContentPresenter IsHitTestVisible="False" 
                                              Content="{TemplateBinding SelectionBoxItem}" 
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
                                              Margin="6,4,20,4" 
                                              VerticalAlignment="Center" 
                                              HorizontalAlignment="Left">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                            <Popup Name="Popup" 
                                   Placement="Bottom" 
                                   IsOpen="{TemplateBinding IsDropDownOpen}" 
                                   AllowsTransparency="True" 
                                   Focusable="False" 
                                   PopupAnimation="Slide">
                                <Grid Name="DropDown" 
                                      SnapsToDevicePixels="True" 
                                      MinWidth="{TemplateBinding ActualWidth}" 
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" 
                                            Background="#1E1E1E" 
                                            BorderThickness="1" 
                                            BorderBrush="#3E3E42" 
                                            CornerRadius="4" 
                                            Margin="0,2,0,0">
                                        <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolRadioStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#333337"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#007ACC"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#0098FF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#555555"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Toolbar -->
        <Border Grid.Row="0" Background="#202022" BorderBrush="#333337" BorderThickness="0,0,0,1" Padding="10,8">
            <Grid>
                <!-- Drawing Tools & Shapes -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <RadioButton x:Name="PenToolBtn" Style="{StaticResource ToolRadioStyle}" Checked="Tool_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✏️" Margin="0,0,4,0"/>
                            <TextBlock Text="Pen"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="HighlighterToolBtn" Style="{StaticResource ToolRadioStyle}" Checked="Tool_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖍️" Margin="0,0,4,0"/>
                            <TextBlock Text="Highlighter"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="ArrowToolBtn" Style="{StaticResource ToolRadioStyle}" Checked="Tool_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="➡️" Margin="0,0,4,0"/>
                            <TextBlock Text="Arrow"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="RectToolBtn" Style="{StaticResource ToolRadioStyle}" Checked="Tool_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⬜" Margin="0,0,4,0"/>
                            <TextBlock Text="Rectangle"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="CropToolBtn" Style="{StaticResource ToolRadioStyle}" Checked="Tool_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✂️" Margin="0,0,4,0"/>
                            <TextBlock Text="Crop"/>
                        </StackPanel>
                    </RadioButton>

                    <Separator Background="#333337" Margin="8,4" Width="1"/>

                    <!-- Color palette -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                        <Button Width="20" Height="20" Background="#FF3B30" BorderThickness="1" BorderBrush="#FFF" Margin="2,0" Click="Color_Click" Tag="#FF3B30" ToolTip="Red"/>
                        <Button Width="20" Height="20" Background="#FF9500" BorderThickness="0" Margin="2,0" Click="Color_Click" Tag="#FF9500" ToolTip="Orange"/>
                        <Button Width="20" Height="20" Background="#FFCC00" BorderThickness="0" Margin="2,0" Click="Color_Click" Tag="#FFCC00" ToolTip="Yellow"/>
                        <Button Width="20" Height="20" Background="#34C759" BorderThickness="0" Margin="2,0" Click="Color_Click" Tag="#34C759" ToolTip="Green"/>
                        <Button Width="20" Height="20" Background="#007AFF" BorderThickness="0" Margin="2,0" Click="Color_Click" Tag="#007AFF" ToolTip="Blue"/>
                        <Button Width="20" Height="20" Background="#AF52DE" BorderThickness="0" Margin="2,0" Click="Color_Click" Tag="#AF52DE" ToolTip="Purple"/>
                        <Button Width="20" Height="20" Background="#FFFFFF" BorderThickness="0" Margin="2,0" Click="Color_Click" Tag="#FFFFFF" ToolTip="White"/>
                        <Button Width="20" Height="20" Background="#000000" BorderThickness="1" BorderBrush="#555" Margin="2,0" Click="Color_Click" Tag="#000000" ToolTip="Black"/>
                    </StackPanel>

                    <!-- Stroke Size -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                        <TextBlock Text="Width:" Foreground="#888888" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox x:Name="StrokeThicknessCombo" SelectionChanged="Thickness_Changed" Width="68">
                            <ComboBoxItem Content="2 px" Tag="2"/>
                            <ComboBoxItem Content="4 px" Tag="4"/>
                            <ComboBoxItem Content="8 px" Tag="8"/>
                            <ComboBoxItem Content="16 px" Tag="16"/>
                        </ComboBox>
                    </StackPanel>

                    <Button Style="{StaticResource ToolButtonStyle}" Click="Undo_Click" ToolTip="Undo (Ctrl+Z)">
                        <TextBlock Text="↩️ Undo"/>
                    </Button>
                </StackPanel>

                <!-- Actions: Copy, Save As, Save -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ApplyCropBtn" Style="{StaticResource ToolButtonStyle}" Background="#007ACC" Foreground="#FFF" Visibility="Collapsed" Click="ApplyCrop_Click" Margin="0,0,8,0">
                        <TextBlock Text="✂️ Apply Crop"/>
                    </Button>

                    <Button Style="{StaticResource ToolButtonStyle}" Click="Copy_Click" ToolTip="Copy to Clipboard">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋" Margin="0,0,4,0"/>
                            <TextBlock Text="Copy"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ToolButtonStyle}" Click="SaveAs_Click" ToolTip="Save As...">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾" Margin="0,0,4,0"/>
                            <TextBlock Text="Save As..."/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ToolButtonStyle}" Background="#1E7E34" Foreground="#FFF" Click="Save_Click" ToolTip="Update Current File">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✓" Margin="0,0,4,0"/>
                            <TextBlock Text="Save"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Canvas Viewport with ScrollViewer -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#121212">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                <!-- Outer Border / Shadow for screenshot -->
                <Border BorderBrush="#333337" BorderThickness="1" CornerRadius="4">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.6"/>
                    </Border.Effect>

                    <Grid x:Name="CanvasContainer" ClipToBounds="True">
                        <!-- Background captured image -->
                        <Image x:Name="SourceImage" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top"/>

                        <!-- Smooth Freehand Ink Layer -->
                        <InkCanvas x:Name="DrawingInkCanvas" Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Top"/>

                        <!-- Shapes / Overlay Layer for Arrows, Rectangles, Crop guides -->
                        <Canvas x:Name="ShapesCanvas" Background="Transparent" 
                                MouseLeftButtonDown="ShapesCanvas_MouseDown"
                                MouseMove="ShapesCanvas_MouseMove"
                                MouseLeftButtonUp="ShapesCanvas_MouseUp"/>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#202022" BorderBrush="#333337" BorderThickness="0,1,0,0" Padding="14,6">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="FilePathStatusText" Text="File:" Foreground="#888888" FontSize="11"/>
                    <TextBlock Text="  •  " Foreground="#444444" FontSize="11"/>
                    <TextBlock x:Name="DimensionsStatusText" Text="0 × 0" Foreground="#00D2FF" FontSize="11" FontWeight="SemiBold"/>
                </StackPanel>

                <TextBlock x:Name="ToolStatusText" Text="Pen tool active  •  ESC: Exit  •  Ctrl+S: Save  •  Ctrl+C: Copy to Clipboard" 
                           Foreground="#777777" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>

