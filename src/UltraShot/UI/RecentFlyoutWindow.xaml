<Window x:Class="UltraShot.UI.RecentFlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recent Screenshots"
        Width="360" Height="500"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Deactivated="Window_Deactivated">
    <Window.Resources>
        <!-- Dark modern scrollbar style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- Modern button style -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3E3E42"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#007ACC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3E3E42"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- In-Place Delete Confirmation Button Styles -->
        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#C42B1C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E81123"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#A80000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CancelButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#333337"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#444448"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#252526"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#1E1E1E"
            BorderBrush="#333337"
            BorderThickness="1"
            CornerRadius="10"
            Margin="8">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Opacity="0.5"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#252526" CornerRadius="9,9,0,0" Padding="14,10" BorderBrush="#333337" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📸" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Recent Screenshots" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource IconButtonStyle}" ToolTip="Open Folder" Click="OpenFolder_Click">
                            <TextBlock Text="📁" FontSize="13"/>
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}" ToolTip="Settings" Click="OpenSettings_Click">
                            <TextBlock Text="⚙️" FontSize="13"/>
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}" ToolTip="Close" Click="Close_Click">
                            <TextBlock Text="✕" FontSize="12" FontWeight="Bold"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content List -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <ItemsControl x:Name="ScreenshotsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#252526"
                                        BorderBrush="#333337"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Margin="10,6"
                                        Padding="8"
                                        Cursor="Hand"
                                        MouseLeftButtonUp="Item_Click">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#2D2D30"/>
                                                    <Setter Property="BorderBrush" Value="#007ACC"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Thumbnail -->
                                        <Border Grid.Column="0" Background="#111111" CornerRadius="4" Height="60" ClipToBounds="True">
                                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Details -->
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}" Foreground="#FFFFFF" FontWeight="Medium" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding FormattedDate}" Foreground="#999999" FontSize="11" Margin="0,3,0,0"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <TextBlock Text="{Binding DimensionsText}" Foreground="#00D2FF" FontSize="11" FontWeight="SemiBold"/>
                                                <TextBlock Text="  •  " Foreground="#666666" FontSize="11"/>
                                                <TextBlock Text="{Binding FileSizeFormatted}" Foreground="#888888" FontSize="11"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Quick Action Buttons -->
                                        <Grid Grid.Column="2" VerticalAlignment="Center">
                                            <StackPanel>
                                                <Button Style="{StaticResource IconButtonStyle}" ToolTip="Edit / Annotate" Click="EditItem_Click" Tag="{Binding}">
                                                    <TextBlock Text="✏️" FontSize="12"/>
                                                </Button>
                                                <Button Style="{StaticResource IconButtonStyle}" ToolTip="Copy to Clipboard" Click="CopyItem_Click" Tag="{Binding}">
                                                    <TextBlock Text="📋" FontSize="12"/>
                                                </Button>
                                                <Button x:Name="DeleteBtn" Style="{StaticResource IconButtonStyle}" ToolTip="Delete" Click="DeleteItem_Click" Tag="{Binding}">
                                                    <TextBlock Text="🗑️" FontSize="12"/>
                                                </Button>
                                            </StackPanel>

                                            <!-- In-place Theme-Consistent Delete Confirmation Popup -->
                                            <Popup x:Name="DeleteConfirmPopup"
                                                   PlacementTarget="{Binding ElementName=DeleteBtn}"
                                                   Placement="Left"
                                                   IsOpen="{Binding IsConfirmOpen, Mode=TwoWay}"
                                                   StaysOpen="False"
                                                   AllowsTransparency="True"
                                                   HorizontalOffset="-6"
                                                   VerticalOffset="-2">
                                                <Border Background="#252526" BorderBrush="#C42B1C" BorderThickness="1" CornerRadius="6" Padding="10,6">
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="3" Opacity="0.6"/>
                                                    </Border.Effect>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="Delete?" Foreground="#FFFFFF" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                        <Button Content="Delete" Style="{StaticResource DangerButtonStyle}" Click="ConfirmDelete_Click" Tag="{Binding}" Margin="0,0,5,0"/>
                                                        <Button Content="Cancel" Style="{StaticResource CancelButtonStyle}" Click="CancelDelete_Click" Tag="{Binding}"/>
                                                    </StackPanel>
                                                </Border>
                                            </Popup>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty state notice -->
                    <StackPanel x:Name="EmptyNotice" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20" Visibility="Collapsed">
                        <TextBlock Text="📷" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="No screenshots yet" Foreground="#CCCCCC" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center"/>
                        <TextBlock Text="Press the hotkey to take your first screenshot." Foreground="#888888" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" Background="#252526" CornerRadius="0,0,9,9" Padding="10,8" BorderBrush="#333337" BorderThickness="0,1,0,0">
                <Grid>
                    <TextBlock x:Name="CountText" Text="Total 0 screenshots" Foreground="#888888" FontSize="11" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource ActionButtonStyle}" HorizontalAlignment="Right" Click="OpenFolder_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📁 Show in Folder" FontSize="11"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

